# === OpenRouter ===
# Chave da sua conta OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxx

# === LiteLLM Proxy ===
# URL do proxy LiteLLM rodando localmente (docker-compose ou `litellm --config`)
LITELLM_PROXY_URL=http://localhost:4000
# "Master key" / virtual key configurada no proxy (ver litellm_proxy/config.yaml)
LITELLM_PROXY_KEY=sk-local-master-key

# === App ===
SDR_APP_NAME=sdr-bot

# === PII (Parte 2) ===
# Salt fixo e secreto usado no hash de CPF/CNPJ (nunca reversível,
# usado só pra correlação "é o mesmo lead de antes?"). Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA reutilize o mesmo salt entre ambientes (dev/staging/produção).
PII_HASH_SALT=

# === Observabilidade (Parte 5) ===

# --- Phoenix (self-hospedado, roda local, sem conta/chave necessária) ---
# Precisa ser o endpoint de INGESTÃO OTLP, não a URL da UI -- descoberto
# testando de verdade: apontar só pra http://localhost:6006 (a raiz)
# falha com 405 Method Not Allowed, span nunca chega.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# --- LangFuse (self-hospedado -- postgres+clickhouse+redis+minio) ---
# URL onde o LangFuse fica acessível (padrão do docker-compose)
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_HOST=http://localhost:3000

# Segredos internos do LangFuse -- cada um gerado independente, gere
# TODOS com o mesmo comando (32 bytes hex):
#   python -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=

# Senhas dos serviços de infra (postgres/clickhouse/redis/minio) --
# mesmo comando de geração acima, um valor diferente pra cada:
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_PASSWORD=

# API keys do projeto que o LangFuse cria sozinho no primeiro boot
# (LANGFUSE_INIT_*, ver langfuse/docker-compose.yml). Nome canônico
# aqui (LANGFUSE_PUBLIC_KEY/SECRET_KEY, não LANGFUSE_INIT_*) porque o
# MESMO par de chaves também é usado pelo LiteLLM Proxy (callback
# langfuse_otel, ver litellm_proxy/config.yaml) -- um nome só, dois
# consumidores, sem risco de dessincronizar. Gere os dois com o mesmo
# comando de 32 bytes hex:
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Senha de login da UI do LangFuse (usuário "Admin", e-mail abaixo)
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_EMAIL=admin@helssing.local

# Host do LangFuse que o LiteLLM Proxy usa pra montar o endpoint OTLP
# (`{LANGFUSE_OTEL_HOST}/api/public/otel`, automático, não precisa
# configurar o path). host.docker.internal em vez de localhost porque
# o LiteLLM Proxy roda no PRÓPRIO container Docker (projeto compose
# separado do langfuse/) -- ver extra_hosts em litellm_proxy/docker-compose.yml.
LANGFUSE_OTEL_HOST=http://host.docker.internal:3000
