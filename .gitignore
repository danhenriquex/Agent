.env
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Parte 4: dados gerados pelo pipeline de ingestão -- regenerável via
# `make ingest-dev`, não deveria ir pro git (binário, muda a cada
# reindexação, e o modelo de embedding baixado junto seria enorme).
mcp_server/chroma_data/
# Dagster cria isso automaticamente quando DAGSTER_HOME não está
# setado (nosso caso, dev local) -- efêmero por natureza.
.tmp_dagster_home*/

scripts/*

# SQLite local (dev) da sessão persistente (app/session_service.py) --
# nunca commitar dados de sessão; produção usa Postgres via SESSION_DB_URL.
sdr_bot_sessions.db
sdr_bot_sessions.db-*

# Terraform (Parte 7): state e vars locais nunca vão pro git -- o state
# guarda IDs de recurso/emails de SA (não segredo, mas não deveria vazar
# à toa), e terraform.tfvars real não precisa ser versionado sobre o
# .example.
terraform/.terraform/
terraform/*.tfstate*
terraform/terraform.tfvars
# saída de `terraform plan -out=tfplan` -- artefato local/pontual, pode
# conter valores de secret em texto puro no diff planejado.
terraform/tfplan
app/agents/.adk/session.db
